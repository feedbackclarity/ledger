# Copy to .env.local for local dev. On DigitalOcean, set these in the App Platform UI.

# Set this to ANY long random string. Used to encrypt sessions.
NEXTAUTH_SECRET=replace-with-32-char-random-string-please

# For local: http://localhost:3000
# For DO: the URL DO assigns you (e.g. https://ledger-xyz.ondigitalocean.app)
NEXTAUTH_URL=http://localhost:3000

# Your login password (plain text — it gets hashed at runtime)
LEDGER_PASSWORD=change-this-to-your-password

# Where the SQLite file and uploads live. Local: ./data and ./uploads. DO: /data and /uploads (volume mount)
DATA_DIR=./data
UPLOADS_DIR=./uploads
